generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["devops_cli"]
}

model categories {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(100)
  description String?
  icon        String?   @db.VarChar(100)
  color       String?   @db.VarChar(10)
  created_at  DateTime  @default(now()) @db.Timestamp(6)
  commands    commands[]

  @@schema("devops_cli")
}

model commands {
  id               Int                  @id @default(autoincrement())
  name             String               @unique @db.VarChar(255)
  description      String?
  command_template String
  category         String               @db.VarChar(100)
  tags             String[]              @default([])
  example          String?
  syntax_help      String?
  created_at       DateTime             @default(now()) @db.Timestamp(6)
  updated_at       DateTime             @default(now()) @updatedAt @db.Timestamp(6)
  category_ref     categories           @relation(fields: [category], references: [name])
  properties       command_properties[]
  templates        command_templates[]
  copy_history     copy_history[]

  @@index([category], map: "idx_commands_category")
  @@index([tags], type: Gin, map: "idx_commands_tags")
  @@index([name], map: "idx_commands_name")
  @@schema("devops_cli")
}

model command_properties {
  id                 Int       @id @default(autoincrement())
  command_id         Int
  property_name      String    @db.VarChar(100)
  property_type      String    @db.VarChar(50)
  default_value      String?
  is_required        Boolean   @default(false)
  placeholder        String?
  description        String?   @db.VarChar(255)
  select_options     Json?
  validation_pattern String?   @db.VarChar(255)
  display_order      Int?
  created_at         DateTime  @default(now()) @db.Timestamp(6)
  command            commands  @relation(fields: [command_id], references: [id], onDelete: Cascade)

  @@unique([command_id, property_name])
  @@index([command_id], map: "idx_command_properties_command_id")
  @@schema("devops_cli")
}

model command_templates {
  id              Int            @id @default(autoincrement())
  command_id      Int
  template_name   String         @db.VarChar(255)
  property_values Json
  description     String?
  created_at      DateTime       @default(now()) @db.Timestamp(6)
  updated_at      DateTime       @default(now()) @updatedAt @db.Timestamp(6)
  command         commands       @relation(fields: [command_id], references: [id], onDelete: Cascade)
  copy_history    copy_history[]

  @@schema("devops_cli")
}

model copy_history {
  id                   Int                @id @default(autoincrement())
  command_id           Int
  command_template_id  Int?
  copied_command       String
  property_values      Json?
  copied_at            DateTime           @default(now()) @db.Timestamp(6)
  command              commands           @relation(fields: [command_id], references: [id], onDelete: Cascade)
  template             command_templates? @relation(fields: [command_template_id], references: [id], onDelete: SetNull)

  @@index([copied_at], map: "idx_copy_history_created_at")
  @@index([command_id], map: "idx_copy_history_command_id")
  @@schema("devops_cli")
}

model feature_requests {
  id              Int      @id @default(autoincrement())
  title           String   @db.VarChar(255)
  description     String
  command_example String?
  category        String?  @db.VarChar(100)
  priority        String   @default("medium") @db.VarChar(50)
  status          String   @default("pending") @db.VarChar(50)
  votes_up        Int      @default(0)
  votes_down      Int      @default(0)
  notes           String?
  properties      Json?    @default("[]")
  requested_by    String   @default("anonymous") @db.VarChar(100)
  requested_at    DateTime @default(now()) @db.Timestamp(6)
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamp(6)

  @@index([status], map: "idx_feature_requests_status")
  @@index([category], map: "idx_feature_requests_category")
  @@index([votes_up(sort: Desc)], map: "idx_feature_requests_votes")
  @@schema("devops_cli")
}
